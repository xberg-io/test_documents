digraph graphviz_states {
  "idle" [shape=circle fillcolor="#b3de69"];
  "running" [shape=circle fillcolor="#b3de69"];
  "paused" [shape=circle fillcolor="#b3de69"];
  "done" [shape=doublecircle fillcolor="#fb8072"];
  "idle" -> "running" [label="start"];
  "running" -> "paused" [label="pause"];
  "paused" -> "running" [label="resume"];
  "running" -> "done" [label="finish"];
}
